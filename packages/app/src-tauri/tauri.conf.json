{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CARDstock",
  "version": "../package.json",
  "identifier": "dev.cardstock.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CARDstock",
        "label": "main",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Parametric solid modelling, simplified.",
    "longDescription": "Parametric solid modelling, simplified. No bells or whistles or $. Intended mainly for 3D printing.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "card"
        ],
        "name": "CARDstock part",
        "description": "CARDstock part",
        "mimeType": "application/x-cardstock",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
