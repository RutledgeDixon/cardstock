{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src/**/*"
  ],
  "references": [
    {
      "path": "../types"
    },
    {
      "path": "../document"
    },
    {
      "path": "../commands"
    },
    {
      "path": "../viewer"
    }
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "dist"
  ]
}
